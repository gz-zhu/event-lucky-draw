include ../mixins/icons

.main
  .control-group
    button#fullscreen-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='fullscreen')
    button#records-toggle.icon-button.icon-button--small(title="Records")
      svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
        path(d="M9 11l3 3L22 4")
        path(d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11")
    button#settings-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='settings')

  a.display-link(href="/display.html" target="_blank") 📺 Display
  
  canvas#confetti-canvas.confetti
  canvas#lights-canvas.lights-canvas
  #winners-ticker.winners-ticker
    .winners-ticker__label 🏆 WINNERS
    .winners-ticker__track
      #winners-ticker__content.winners-ticker__content

  #lucky-draw
    .title
      h1.title-text Lucky Draw

    #prize-buttons.prize-buttons

    #current-prize-label.current-prize-label Please select a prize

    .slot
      .slot__outer
        .slot__inner
          .slot__shadow
          #reel.reel

      #sunburst.sunburst
        img(src="~@images/sunburst.svg" alt="sunburst")

    button#draw-button.solid-button(disabled) Draw

  #records-panel.records-panel(style="display:none")
    .records-panel__inner
      .records-header
        h2 Records
        .records-actions
          button#export-csv.solid-button(style="font-size:0.875rem;padding:0.5rem 1rem") Export CSV
          button#clear-records.solid-button.solid-button--danger(style="font-size:0.875rem;padding:0.5rem 1rem") Clear
          button#records-close.icon-button.icon-button--small
            +svg-icon.red.big(svg-icon-name='close')
      #records-body.records-body

  #settings.settings
    #settings-panel.settings__panel
      div.settings__panel__group
        .settings__title-row
          h1.settings__title Settings
          button#settings-close-x.icon-button.icon-button--small
            +svg-icon.red.big(svg-icon-name='close')
        div.input-group
          .name-list-header
            label.input-label(for="name-list") Name List
            label.upload-csv-btn
              input#csv-upload(type="file" accept=".csv" style="display:none")
              | Upload CSV
          textarea.input-field.input-field--textarea(rows="8" placeholder="Separate each name by line break" id="name-list")

        div.input-group.input-group--2-column
          label.input-label(for="remove-from-list") Remove winner from list
          label.input--switch
            input(type="checkbox" checked="true" id="remove-from-list")
            span.slider

        div.input-group.input-group--2-column
          label.input-label(for="enable-sound") Enable sound effect
          label.input--switch
            input(type="checkbox" checked="true" id="enable-sound")
            span.slider

        div.input-group
          label.input-label Prize Settings
          .prize-config-header
            span Name
            span Count
            span
          #prize-config-list.prize-config-list
          button#add-prize-row.solid-button(style="margin-top:0.75rem;width:100%;font-size:0.875rem") + Add Prize

      div.settings__panel__group
        button#settings-save.solid-button Save
        button#settings-close.solid-button.solid-button--danger Discard and close