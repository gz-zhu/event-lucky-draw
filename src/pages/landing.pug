include ../mixins/icons

.main
  .lang-switcher
    button.lang-switcher__btn.is-active(type="button" data-lang="en") EN
    button.lang-switcher__btn(type="button" data-lang="zh") 中
    button.lang-switcher__btn(type="button" data-lang="ja") 日
    button.lang-switcher__btn(type="button" data-lang="my") မြ

  .control-group
    button#fullscreen-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='fullscreen')
    button#records-toggle.icon-button.icon-button--small(title="Records" data-i18n-title="recordsTitle")
      svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
        path(d="M9 11l3 3L22 4")
        path(d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11")
    button#settings-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='settings')

  a.display-link(href="/display.html" target="_blank" data-i18n="displayLink") 📺 Display

  canvas#confetti-canvas.confetti
  canvas#lights-canvas.lights-canvas
  #winners-ticker.winners-ticker
    .winners-ticker__label(data-i18n="tickerLabel") 🏆 WINNERS
    .winners-ticker__track
      #winners-ticker__content.winners-ticker__content

  #recovery-banner.recovery-banner(style="display:none")
    span#recovery-message
    .recovery-banner__actions
      button#recovery-restore.solid-button(data-i18n="restoreBtn") Restore
      button#recovery-dismiss.recovery-dismiss(data-i18n="dismissBtn") Dismiss

  .brand-tag Lucky Draw

  #lucky-draw
    .title
      h1#draw-title-display.title-text

    #prize-buttons.prize-buttons

    #countdown-bar.countdown-bar(style="display:none")
      .countdown-bar__summary
        .countdown-bar__time#countdown-bar-time 00:00
        .countdown-bar__label(data-i18n="countdownLabelShort") Countdown
      .countdown-bar__progress
        .countdown-bar__progress-track
          #countdown-bar-progress.countdown-bar__progress-fill
      .countdown-bar__controls
        .countdown-bar__input-wrap
          span.countdown-bar__input-icon ⏱
          input#countdown-seconds.countdown-bar__input(type="number" min="0" max="3600" step="5" value="0")
          span.countdown-bar__unit(data-i18n="secondsUnit") sec
        button#countdown-toggle.solid-button.countdown-bar__btn Start
        button#countdown-reset.solid-button.countdown-bar__btn.countdown-bar__btn--reset(data-i18n="countdownResetBtn") Reset
        button#countdown-cancel.solid-button.countdown-bar__btn.countdown-bar__btn--cancel(data-i18n="countdownCancelBtn") Cancel
        .countdown-bar__auto
          span.countdown-bar__auto-text(data-i18n="autoBtn") Auto
          label.countdown-switch(title="Auto draw when countdown ends" data-i18n-title="autoTitle")
            input#countdown-auto(type="checkbox")
            span.countdown-switch__track

    .main-clock-wrap
      #main-clock-time.main-clock-time 00:00:00
      #main-clock-date.main-clock-date

    .slot
      .slot__outer
        .slot__inner
          .slot__shadow
          #reel.reel

      #sunburst.sunburst
        img(src="~@images/sunburst.svg" alt="sunburst")

    button#draw-button.solid-button(disabled data-i18n="drawBtn") Draw
    #participant-count.participant-count
    #draw-seed.draw-seed

  #records-panel.records-panel(style="display:none")
    .records-panel__inner
      .records-header
        h2(data-i18n="recordsHeading") Records
        .records-actions
          button#export-csv.solid-button(style="font-size:0.875rem;padding:0.5rem 1rem" data-i18n="exportCsvBtn") Export CSV
          button#clear-records.solid-button.solid-button--danger(style="font-size:0.875rem;padding:0.5rem 1rem" data-i18n="clearRecordsBtn") Clear
          button#records-close.icon-button.icon-button--small
            +svg-icon.red.big(svg-icon-name='close')
      #records-body.records-body

  #settings.settings
    #settings-panel.settings__panel
      .settings__shell
        .settings__title-row
          h1.settings__title(data-i18n="settingsTitle") Settings
          .settings__title-actions
            button#reset-all-defaults.reset-all-btn(type="button" data-i18n="resetAllBtn") Reset All
            button#settings-close-x.icon-button.icon-button--small
              +svg-icon.red.big(svg-icon-name='close')

        .settings__tabs(role="tablist" aria-label="Settings sections")
          button#settings-tab-btn-name-list.settings__tab.is-active(type="button" role="tab" aria-selected="true" aria-controls="settings-tab-name-list" data-settings-tab="name-list" data-i18n="nameListLabel") Name List
          button#settings-tab-btn-prize-settings.settings__tab(type="button" role="tab" aria-selected="false" aria-controls="settings-tab-prize-settings" data-settings-tab="prize-settings" data-i18n="prizeSettingsLabel") Prize Settings
          button#settings-tab-btn-general.settings__tab(type="button" role="tab" aria-selected="false" aria-controls="settings-tab-general" data-settings-tab="general" data-i18n="drawSettingsTab") Draw Settings

        .settings__body
          #settings-tab-name-list.settings__tab-panel.is-active(role="tabpanel" aria-labelledby="settings-tab-btn-name-list" data-settings-panel="name-list")
            .input-group
              label.input-label(for="draw-title-input" data-i18n="drawTitleLabel") Draw Title
              input#draw-title-input.input-field(type="text" placeholder="e.g. Annual Dinner 2026" maxlength="60" data-i18n-placeholder="drawTitlePlaceholder")

            .input-group
              .name-list-toolbar
                button#namelist-shuffle-btn.namelist-tool-btn(type="button")
                  span.namelist-tool-btn__emoji.namelist-tool-btn__emoji--shuffle
                  span.namelist-tool-btn__label(data-i18n="shuffleBtnTitle") Random sort
                button#namelist-mask-btn.namelist-tool-btn(type="button" title="Hide personal info" data-i18n-title="maskBtnTitle" aria-label="Hide personal info")
                  span.namelist-tool-btn__emoji.namelist-tool-btn__emoji--privacy
                  span.namelist-tool-btn__label(data-i18n="maskBtnLabel") Privacy
                button#namelist-merge-btn.namelist-tool-btn(type="button" title="Merge duplicates" data-i18n-title="mergeBtnTitle" aria-label="Merge duplicates")
                  span.namelist-tool-btn__emoji.namelist-tool-btn__emoji--merge
                  span.namelist-tool-btn__label(data-i18n="mergeBtnLabel") Merge
                button#namelist-clear-btn.namelist-tool-btn.namelist-tool-btn--danger(type="button" title="Clear list" data-i18n-title="clearListBtnTitle" aria-label="Clear list")
                  span.namelist-tool-btn__emoji.namelist-tool-btn__emoji--clear
                  span.namelist-tool-btn__label(data-i18n="clearBtnLabel") Clear
                label.upload-csv-btn
                  input#csv-upload(type="file" accept=".csv" style="display:none")
                  span.upload-csv-btn__icon ⭱
                  span(data-i18n="uploadCsvBtn") Upload CSV
              textarea#name-list.input-field.input-field--textarea(rows="8" placeholder="One name per line (supports 10,000+ participants).\nFor CSV: one row = one participant. If a row has multiple columns, they are merged into one name." data-i18n-placeholder="nameListPlaceholder")
              #name-list-stats.name-list-stats
                .name-list-stats__item
                  span.name-list-stats__label(data-i18n="nameListRawCountLabel") Entries
                  span#name-list-raw-count.name-list-stats__value 0
                .name-list-stats__item
                  span.name-list-stats__label(data-i18n="nameListPoolCountLabel") Pool
                  span#name-list-pool-count.name-list-stats__value 0
                .name-list-stats__item
                  span.name-list-stats__label(data-i18n="nameListDuplicateCountLabel") Duplicates
                  span#name-list-duplicate-count.name-list-stats__value 0
                .name-list-stats__item
                  span.name-list-stats__label(data-i18n="nameListWinnerRemovedLabel") Removed winners
                  span#name-list-winner-removed-count.name-list-stats__value 0
              #dedupe-notice.dedupe-notice

          #settings-tab-prize-settings.settings__tab-panel(role="tabpanel" aria-labelledby="settings-tab-btn-prize-settings" data-settings-panel="prize-settings")
            .settings__section-header
              span.settings__section-title(data-i18n="prizeSettingsLabel") Prize Settings
              button#reset-prizes.prize-reset-btn(type="button" data-i18n="resetPrizesBtn") Reset Prize Settings
            #prize-config-list.prize-config-list
            button#add-prize-row.solid-button.settings__add-prize(type="button" data-i18n="addPrizeBtn") + Add Prize

          #settings-tab-general.settings__tab-panel(role="tabpanel" aria-labelledby="settings-tab-btn-general" data-settings-panel="general")
            .input-group
              .spin-duration-header
                label.input-label(for="spin-duration-range" data-i18n="spinDurationLabel") Draw Scroll Time
                span.spin-duration-value
                  span#spin-duration-value 20
                  span(data-i18n="secondsUnit") sec
              input#spin-duration-range.spin-duration-range(type="range" min="5" max="60" step="5" value="20")
              .spin-duration-scale
                span 5
                span 10
                span 20
                span 30
                span 40
                span 50
                span 60

            .settings__toggle-list
              .input-group.input-group--2-column.settings__toggle-row
                span.input-label(data-i18n="removeWinnerLabel") Remove winner from list
                label.input--switch
                  input(type="checkbox" checked="true" id="remove-from-list")
                  span.slider

              .input-group.input-group--2-column.settings__toggle-row
                span.input-label(data-i18n="enableSoundLabel") Enable sound effect
                label.input--switch
                  input(type="checkbox" checked="true" id="enable-sound")
                  span.slider

        .settings__footer
          button#settings-save.solid-button.settings__save(type="button" data-i18n="saveBtn") Save
          button#settings-close.settings__ghost(type="button" data-i18n="discardBtnIcon") ✖ Discard and close
