include ../mixins/icons

.main
  .control-group
    button#fullscreen-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='fullscreen')
    button#records-toggle.icon-button.icon-button--small(title="Records")
      svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
        path(d="M9 11l3 3L22 4")
        path(d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11")
    button#settings-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='settings')

  a.display-link(href="/display.html" target="_blank") 📺 Display
  
  canvas#confetti-canvas.confetti
  canvas#lights-canvas.lights-canvas
  #winners-ticker.winners-ticker
    .winners-ticker__label 🏆 WINNERS
    .winners-ticker__track
      #winners-ticker__content.winners-ticker__content

  #recovery-banner.recovery-banner(style="display:none")
    span#recovery-message
    .recovery-banner__actions
      button#recovery-restore.solid-button Restore
      button#recovery-dismiss.recovery-dismiss Dismiss

  .brand-tag Lucky Draw

  #lucky-draw
    .title
      h1#draw-title-display.title-text

    #prize-buttons.prize-buttons

    #current-prize-label.current-prize-label(style="display:none") Please select a prize

    #countdown-bar.countdown-bar(style="display:none")
      .countdown-bar__time#countdown-bar-time 00:00
      .countdown-bar__controls
        button#countdown-toggle.solid-button.countdown-bar__btn Start
        button#countdown-reset.solid-button.countdown-bar__btn.solid-button--secondary Reset
        button#countdown-cancel.solid-button.countdown-bar__btn.countdown-bar__btn--cancel Cancel

    .main-clock-wrap
      #main-clock-time.main-clock-time 00:00:00
      #main-clock-date.main-clock-date

    .slot
      .slot__outer
        .slot__inner
          .slot__shadow
          #reel.reel

      #sunburst.sunburst
        img(src="~@images/sunburst.svg" alt="sunburst")

    button#draw-button.solid-button(disabled) Draw
    #participant-count.participant-count
    #draw-seed.draw-seed

  #records-panel.records-panel(style="display:none")
    .records-panel__inner
      .records-header
        h2 Records
        .records-actions
          button#export-csv.solid-button(style="font-size:0.875rem;padding:0.5rem 1rem") Export CSV
          button#clear-records.solid-button.solid-button--danger(style="font-size:0.875rem;padding:0.5rem 1rem") Clear
          button#records-close.icon-button.icon-button--small
            +svg-icon.red.big(svg-icon-name='close')
      #records-body.records-body

  #settings.settings
    #settings-panel.settings__panel
      div.settings__panel__group
        .settings__title-row
          h1.settings__title Settings
          button#settings-close-x.icon-button.icon-button--small
            +svg-icon.red.big(svg-icon-name='close')
        div.input-group
          label.input-label(for="draw-title-input") Draw Title
          input#draw-title-input.input-field(type="text" placeholder="Lucky Draw" maxlength="60")

        div.input-group
          .name-list-header
            label.input-label(for="name-list") Name List
            label.upload-csv-btn
              input#csv-upload(type="file" accept=".csv" style="display:none")
              | Upload CSV
          textarea.input-field.input-field--textarea(rows="8" placeholder="Separate each name by line break" id="name-list")
          #dedupe-notice.dedupe-notice

        div.input-group.input-group--2-column
          span.input-label Remove winner from list
          label.input--switch
            input(type="checkbox" checked="true" id="remove-from-list")
            span.slider

        div.input-group.input-group--2-column
          span.input-label Enable sound effect
          label.input--switch
            input(type="checkbox" checked="true" id="enable-sound")
            span.slider

        div.input-group
          .prize-settings-title-row
            span.input-label Prize Settings
            button#reset-prizes.prize-reset-btn Reset to default
          .prize-config-header
            span Name
            span Count
            span Draw Time
            span
          #prize-config-list.prize-config-list
          button#add-prize-row.solid-button(style="margin-top:0.75rem;width:100%;font-size:0.875rem") + Add Prize

        div.input-group
          .countdown-cfg-header
            label.input-label ⏱ Countdown Timer
          p.countdown-cfg-hint
            | Select a prize and set a duration. Staff will see a Start / Pause / Reset bar on the main screen when that prize is active.
          .countdown-cfg-row
            select#countdown-cfg-prize.input-field.countdown-cfg-select
              option(value="") — Select prize —
            .countdown-cfg-duration
              input#countdown-cfg-mins.input-field(type="number" min="1" max="99" placeholder="min")
              span.countdown-cfg-unit min
          p.countdown-cfg-clear-hint Leave prize blank to disable the countdown.

      div.settings__panel__group
        button#settings-save.solid-button Save
        button#settings-close.solid-button.solid-button--danger Discard and close